# docker-compose 用的环境变量。复制成 .env 再填：cp .env.example .env
# .env 已在 .gitignore 里，别把密钥提交上去。

# JWT 签名密钥。必须设，且要是足够长的随机值。
# 不设也能起容器，但 MINGLU_ENV=prod 下 app/config.py 的启动自检会直接拒绝。
JWT_SECRET=

# postgres 密码。改了之后如果报 password authentication failed：
# postgres 的 entrypoint 只初始化空数据目录，旧 pgdata 卷沿用旧密码，
# 开发库 docker compose down -v 删卷重来。
POSTGRES_PASSWORD=

# api 对外端口，默认 8000
API_PORT=

# 境内模型服务商。白名单在 services/api/app/config.py 的 ALLOWED_LLM_BASE_URLS，
# 这里只能填白名单里的**完整路径前缀**（不是裸域名），境外的会被拒。
# 可直接用的几家：
#   智谱GLM   https://open.bigmodel.cn/api/paas/v4
#   deepseek  https://api.deepseek.com
#   moonshot  https://api.moonshot.cn/v1
#   百炼      https://dashscope.aliyuncs.com/compatible-mode/v1
#   方舟      https://ark.cn-beijing.volces.com/api/v3
#   百川      https://api.baichuan-ai.com/v1
# 配错了不会报错，只会静默降级成知识库模板——启动日志里会打当前用的是哪个 provider。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 导出摘要链接的对外前缀（用户分享时看到的地址）
PUBLIC_BASE_URL=

# 运营后台（/admin）账号。dev 下不填用默认 admin / dev-only-admin-password，
# prod 必须改，否则启动自检直接拒绝（和 JWT_SECRET 一个待遇）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 思考强度，只对"始终思考"的模型有意义（glm-5.x / deepseek-r1）：low / high / max。
# 健康陪伴场景建议 low——实测 glm-5.3-flash 默认档 12s、输出保守像客服；low 档
# reasoning 归零、延迟相近，人设和共情都在。换非思考模型时把这行清空（传了可能被拒）。
LLM_REASONING_EFFORT=
