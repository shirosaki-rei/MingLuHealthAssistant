{
	"name": "android",
	"appid": "__UNI__9680CDD",
	"description": "",
	"versionName": "1.0.0",
	"versionCode": "100",
	"uni-app-x": {
		"styleIsolationVersion": "2",
		"vapor": true,
		"vapor-render-target": "bytecode"
	},
	/* 快应用特有相关 */
	"quickapp": {},
	/* 小程序特有相关 */
	"mp-weixin": {
		"appid": "wxf123606953375e8b",
		"setting": {
			"urlCheck": false,
			/* 组件按需注入：只注入页面真正引用到的自定义组件，没用到的连代码都不进包。
			   需要基础库 2.11.1+。见 developers.weixin.qq.com/miniprogram/dev/framework/ability/lazyload.html */
			"lazyCodeLoading": "requiredComponents"
		},
		"usingComponents": true,
		/* 开了 darkmode，小程序端才认 @media (prefers-color-scheme)，
		   否则暗色那套变量永远不匹配（和 App 端 defaultAppTheme 是一对） */
		"darkmode": true
	},
	"mp-alipay": {
		"usingComponents": true
	},
	"mp-baidu": {
		"usingComponents": true
	},
	"mp-toutiao": {
		"usingComponents": true
	},
	"uniStatistics": {
		"enable": false
	},
	"vueVersion": "3",
	"app": {
		/* auto = appTheme 跟随系统夜间模式。不配默认是 light，
		   此时 @media (prefers-color-scheme: dark) 永远不匹配（实测）。 */
		"defaultAppTheme": "auto",
		"distribute": {
			"icons": {
				"android": {
					"hdpi": "",
					"xhdpi": "",
					"xxhdpi": "",
					"xxxhdpi": ""
				}
			}
		}
	},
	"app-android": {
		"distribute": {
			/* 本地/联调后端是明文 HTTP，开发期放行；上线前删掉这一段并改 api/http.ts 的 BASE_URL */
			"manifest": {
				"application": {
					"android:usesCleartextTraffic": "true"
				}
			},
			"modules": {},
			"icons": {
				"hdpi": "",
				"xhdpi": "",
				"xxhdpi": "",
				"xxxhdpi": ""
			},
			"splashScreens": {
				"default": {}
			}
		}
	},
	"app-ios": {
		"distribute": {
			"modules": {},
			"icons": {},
			"splashScreens": {}
		}
	}
}
