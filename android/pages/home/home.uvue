<template>
	<view class="page">
		<scroll-view class="scroll" direction="vertical">
			<!-- 问候 + 就诊人头像，右侧头像替代了原来单独的就诊人卡 -->
			<view class="greeting">
				<view class="grow">
					<text class="greetingDate">{{ todayText }} · {{ weekdayText }}</text>
					<text class="h1">{{ greeting }}，{{ userName }}</text>
					<text class="meta">{{ phoneMasked }} · 会员 {{ membershipLabel }}</text>
				</view>
				<!-- 账号头像：点它进账号信息页改昵称。跟下面就诊人条里的 patientDot 是两回事——
				     那个是就诊人首字，这个是账号首字（原型里问候语旁的 avatar 也是账号的）。
				     背景和 @tap 都挂在 view 上，见 App.uvue .avatarBtn 的注释。
				     上传过头像就换成图片，见 App.uvue .avatarBtnImg。 -->
				<view class="avatarBtn" @tap="goAccount">
					<image v-if="accountAvatarUrl !== ''" class="avatarBtnImg" :src="accountAvatarUrl" mode="aspectFill" />
					<text v-else class="avatarBtnText">{{ accountAvatarText }}</text>
				</view>
			</view>

			<!-- 就诊人上下文：预问诊/时间线/记忆都绑到具体的人，整条可点直接换人。
			    用 picker 而不是 button：原生底部滚轮，不用跳去管理页再跳回来 -->
			<view v-if="patients.length > 0">
				<picker class="patientSwitch" :range="patientNames" :value="patientIndex" @change="onPickPatient">
					<view class="patientSwitchIn">
						<text class="patientDot">{{ avatarText }}</text>
						<text class="grow patientSwitchText">{{ patientLine }}</text>
						<text class="patientArr">&#9662;</text>
					</view>
				</picker>
			</view>

			<view class="empty" v-if="patients.length === 0">
				<text class="emptyText">还没有就诊人。先建一份档案，预问诊、时间线和记忆都按人分开记。</text>
				<button class="heroBtn emptyBtn" @click="go('/pages/patients/patients')">新建就诊人</button>
			</view>

			<!-- 首屏唯一强主行动 -->
			<view class="hero" v-if="patients.length > 0">
				<text class="heroKicker">YOUR HEALTH COMPANION</text>
				<text class="heroTitle">身体有哪里不舒服？我们慢慢说。</text>
				<text class="heroDesc">先聊聊感受，明路会追问几个问题、判断紧急程度，再把你的回答整理成一份能给医生看的病历。</text>
				<button class="heroBtn" @click="go('/pages/chat/chat')">开始健康对话</button>
			</view>

			<text class="section">常用功能</text>
			<view class="tiles">
				<view v-for="n in navs" :key="n.url" class="tile" @tap="go(n.url)">
					<view class="tileBox">
						<text class="tileIcon">{{ ic(n.icon) }}</text>
						<text class="tileText">{{ n.label }}</text>
					</view>
				</view>
			</view>

			<view class="rowBetween sectionHead">
				<text class="section">今天的安排</text>
				<button class="textbtn" @click="go('/pages/reminder/reminder')">全部提醒</button>
			</view>
			<view class="empty" v-if="reminders.length === 0">
				<text class="emptyText">未来 24 小时没有要响的提醒</text>
			</view>
			<view v-for="r in reminders" :key="r.id" class="reminderCard">
				<text class="reminderTime">{{ reminderTime(r.fire_at) }}</text>
				<view class="reminderInfo">
					<text class="cardTitle">{{ r.title }}</text>
					<text class="cardMeta" v-if="r.content !== undefined && r.content !== ''">{{ r.content }}</text>
				</view>
			</view>

			<view class="rowBetween sectionHead">
				<text class="section">最近的健康记录</text>
				<button class="textbtn" @click="go('/pages/timeline/timeline')">查看时间线</button>
			</view>
			<view class="empty" v-if="events.length === 0">
				<text class="emptyText">还没有记录。聊几句、或做一次预问诊，这里就会慢慢长出你的健康档案。</text>
			</view>
			<view v-for="ev in events" :key="ev.id" class="recordRow">
				<text class="recordDot">{{ typeLabel(ev.type) }}</text>
				<view class="grow">
					<text class="cardTitle">{{ ev.title }}</text>
					<text class="cardMeta">{{ shortTime(ev.occurred_at) }}</text>
				</view>
			</view>

			<text class="error" v-if="error !== ''">{{ error }}</text>
		</scroll-view>

		<!-- 底部一级入口：首页 / 找医生 / 问助手(中央) / 健康 / 我的 -->
		<view class="tabbar">
			<view class="tab" @tap="switchTab('/pages/home/home')">
				<text class="tabIconOn">{{ ic('home') }}</text>
				<text class="tabTextOn">首页</text>
			</view>
			<view class="tab" @tap="switchTab('/pages/doctors/doctors')">
				<text class="tabIcon">{{ ic('travel_explore') }}</text>
				<text class="tabText">找医生</text>
			</view>
			<view class="tabCenter" @tap="switchTab('/pages/chat/chat')">
				<view class="tabCenterBtn">
					<text class="tabCenterText">问助手</text>
				</view>
				<text class="tabCenterLabel">问助手</text>
			</view>
			<view class="tab" @tap="switchTab('/pages/health/health')">
				<text class="tabIcon">{{ ic('favorite') }}</text>
				<text class="tabText">健康</text>
			</view>
			<view class="tab" @tap="switchTab('/pages/person/person')">
				<text class="tabIcon">{{ ic('person') }}</text>
				<text class="tabText">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { computed, ref } from 'vue'
	import { api } from '@/api'
	import { auth, isLoggedIn } from '@/stores/auth'
	import { session } from '@/stores/session'
	import type { components } from '@/types/api'
	import { errText } from '@/utils/apierr'
	import { hasList, hasText } from '@/utils/blank'
	import { appOnly } from '@/utils/apponly'
	import { ic } from '@/utils/icons'

	type Patient = components['schemas']['Patient']
	type TimelineEvent = components['schemas']['TimelineEvent']
	type PendingReminder = components['schemas']['PendingReminder']

	const patients = ref<Patient[]>([])
	const membershipLabel = ref('—')
	const reminders = ref<PendingReminder[]>([])
	const events = ref<TimelineEvent[]>([])
	const error = ref('')

	const RELATION: Record<string, string> = {
		self: '本人',
		parent: '父/母',
		child: '子女',
		spouse: '配偶',
		other: '其他'
	}

	const TYPE_LABEL: Record<string, string> = {
		consult: '咨询',
		report: '报告',
		preconsult: '预问诊',
		measurement: '测量',
		medication: '用药'
	}

	/** 改版后首页只放 4 个快捷入口，其余从「我的」进——
	 *  原型明确「首页不再重复堆叠所有功能入口」 */
	const navs = [
		{ label: '预问诊', icon: 'assignment', url: '/pages/preconsult/preconsult' },
		{ label: '找医生', icon: 'stethoscope', url: '/pages/doctors/doctors' },
		{ label: '看报告', icon: 'description', url: '/pages/report/report' },
		{ label: '健康', icon: 'monitor_heart', url: '/pages/health/health' }
	]

	/** 选中谁用本地 ref 存，不直接读 session.patientId：
	 *  蒸汽模式下给导入的 reactive 对象赋值，computed 这边实测不重算。
	 *  session 仍然同步写一份，别的页面要读。
	 *  但初值必须从 session 取：标签页跳转用 reLaunch，每跳一次页面就整个重建，
	 *  本地 ref 会回到 ''，loadPatients 第一轮匹配不上就退到「第一个 relation=self 的人」，
	 *  表现就是「切个页面就诊人变回本人」。 */
	const selectedId = ref(session.patientId)

	const current = computed<Patient | null>(() => {
		const list = patients.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id === selectedId.value) return list[i]
		}
		return null
	})

	const userName = computed(() => {
		const p = current.value
		return p === null ? '明路用户' : p.name
	})

	const avatarText = computed(() => {
		const p = current.value
		return p === null ? '明' : p.name.slice(0, 1)
	})

	/* 问候语旁的头像按账号算，不按就诊人：它是账号信息页的入口（原型里这个 avatar
	   也是账号的）。就诊人首字在下面 patientSwitch 里的 patientDot。 */
	const accountAvatarText = computed(() => {
		const n = auth.user === null ? '' : (auth.user.nickname ?? '')
		return hasText(n) ? n.slice(0, 1) : '明'
	})

	/* 上传过头像就用图片，否则空串，模板里 v-if 换回首字圆牌 */
	const accountAvatarUrl = computed(() => (auth.user === null ? '' : (auth.user.avatar_url ?? '')))

	const patientLine = computed(() => {
		const p = current.value
		if (p === null) return '未选择就诊人'
		const age = ageOf(p.birth_date)
		const ageText = age < 0 ? '' : ' · ' + age + ' 岁'
		return p.name + ' · ' + (RELATION[p.relation] ?? p.relation) + ageText
	})

	/** 原生选择器的选项与当前位置，换人只改 session.patientId，其余页面自己重拉 */
	const patientNames = computed(() => patients.value.map(p => p.name + ' · ' + (RELATION[p.relation] ?? p.relation)))

	const patientIndex = computed(() => {
		const list = patients.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id === selectedId.value) return i
		}
		return 0
	})

	function onPickPatient (e: any) {
		const i = Number(e.detail.value)
		const p = patients.value[i]
		if (p === undefined) return
		select(p.id)
	}

	function select (patientId: string) {
		selectedId.value = patientId
		session.patientId = patientId
		loadPanels()
	}

	const contextLine = computed(() => {
		const p = current.value
		if (p === null) return ''
		const parts: string[] = []
		if (hasList(p.chronic_conditions)) parts.push((p.chronic_conditions as string[]).join('、'))
		if (hasText(p.allergy_notes)) parts.push(p.allergy_notes as string)
		return parts.join(' · ')
	})

	const greeting = computed(() => {
		const h = new Date().getHours()
		if (h < 6) return '夜深了'
		if (h < 11) return '早上好'
		if (h < 13) return '中午好'
		if (h < 18) return '下午好'
		return '晚上好'
	})

	const todayText = computed(() => {
		const d = new Date()
		return (d.getMonth() + 1) + '月' + d.getDate() + '日'
	})

	const WEEK = ['日', '一', '二', '三', '四', '五', '六']
	const weekdayText = computed(() => '星期' + WEEK[new Date().getDay()])

	// 模板里不用可选链，uvue 的模板编译器对 ?. 支持情况没验证过
	const phoneMasked = computed(() => (auth.user === null ? '' : auth.user.phone_masked))

	/** 出生日期 → 周岁；日期不合法返回 -1，调用方按「未知」处理 */
	function ageOf (birth: string | null | undefined): number {
		if (!hasText(birth)) return -1
		const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(birth.trim())
		if (m === null) return -1
		const now = new Date()
		let age = now.getFullYear() - Number(m[1])
		// 今年生日还没到就不算一岁
		if (now.getMonth() + 1 < Number(m[2]) || (now.getMonth() + 1 === Number(m[2]) && now.getDate() < Number(m[3]))) age = age - 1
		return age
	}

	function typeLabel (type: string): string {
		return TYPE_LABEL[type] ?? type
	}

	/** ISO 8601 → MM-DD HH:mm，首页只放得下这么多 */
	function shortTime (iso: string): string {
		const d = new Date(iso)
		if (isNaN(d.getTime())) return iso
		const p = (n: number) => (n < 10 ? '0' + n : '' + n)
		return p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes())
	}

	function reminderTime (iso: string): string {
		const d = new Date(iso)
		if (isNaN(d.getTime())) return iso
		const p = (n: number) => (n < 10 ? '0' + n : '' + n)
		return p(d.getHours()) + ':' + p(d.getMinutes())
	}

	// onPageShow 而不是 onLoad：从子页面返回时要刷新就诊人、提醒与记录
	onPageShow(() => {
		if (!isLoggedIn()) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		loadPatients()
		loadMembership()
	})

	async function loadPatients () {
		try {
			const res = await api.listPatients()
			const list = res.items
			// 先定选中谁，最后才写 patients：这次写会触发重渲染，届时选中值必须是新的
			let pick = ''
			if (list.length === 0) {
				selectedId.value = ''
				session.patientId = ''
			} else {
				for (let i = 0; i < list.length; i++) {
					if (list[i].id === selectedId.value) {
						pick = list[i].id
						break
					}
				}
				if (pick === '') {
					for (let i = 0; i < list.length; i++) {
						if (list[i].relation === 'self') {
							pick = list[i].id
							break
						}
					}
				}
				if (pick === '') pick = list[0].id
				selectedId.value = pick
				session.patientId = pick
			}
			patients.value = list
			loadPanels()
		} catch (e) {
			error.value = errText(e)
		}
	}

	/** 提醒与时间线都按当前就诊人取，人没定下来就不请求 */
	async function loadPanels () {
		if (session.patientId === '') return
		try {
			const res = await api.pendingReminders(24)
			reminders.value = res.items
		} catch (e) {
			// 首页这块是附属信息，拉不到不影响主流程
		}
		try {
			const res = await api.timeline(session.patientId, { page: 1, page_size: 3 })
			events.value = res.items
		} catch (e) {
			// 同上
		}
	}

	async function loadMembership () {
		try {
			const m = await api.getMembership()
			membershipLabel.value = m.status === 'active' ? '生效中' : '未开通'
		} catch (e) {
			membershipLabel.value = '—'
		}
	}

	function go (url: string) {
		if (appOnly(url)) return
		uni.navigateTo({ url })
	}

	/** 标签栏这几个都是一级页，但仍用 navigateTo：首页是栈底，返回键永远回得到首页。
	 *  switchTab 要求目标页登记进 pages.json 的 tabBar，那会连带唤起原生 tabBar。 */
	// 底部标签栏：平级页面，reLaunch 清掉页面栈，返回键直接退出而不是逐层回退。
	// 已经在首页就不动——reLaunch 到当前页会整页重刷，没意义。
	function switchTab (url: string) {
		if (url === '/pages/home/home') return
		if (appOnly(url)) return
		uni.reLaunch({ url })
	}

	function goAccount () {
		uni.navigateTo({ url: '/pages/account/account' })
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.scroll {
		flex: 1;
		min-height: 0;
		padding: 24rpx 32rpx 40rpx;
	}

	.grow {
		flex: 1;
		min-width: 0;
	}

	.greeting {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 20rpx;
	}

	.greetingDate {
		font-size: 22rpx;
		color: var(--c-muted);
	}

	/* 就诊人切换：整条可点，picker 负责弹原生滚轮 */
	.patientSwitch {
		margin-bottom: 16rpx;
	}

	.patientSwitchIn {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 20rpx 24rpx;
		border-radius: 16rpx;
		background-color: var(--c-card);
		border: 2rpx solid var(--c-border);
	}

	.patientDot {
		width: 44rpx;
		height: 44rpx;
		border-radius: 50%;
		background-color: var(--c-mint);
		color: var(--c-brand);
		font-size: 22rpx;
		font-weight: bold;
		text-align: center;
		line-height: 44rpx;
		margin-right: 16rpx;
	}

	.patientSwitchText {
		font-size: 26rpx;
		color: var(--c-text-2);
	}

	.patientArr {
		font-size: 28rpx;
		color: var(--c-faint);
	}

	.emptyBtn {
		margin-top: 24rpx;
	}

	.sectionHead {
		margin-bottom: 0;
	}

	/* 今日安排：时间竖线分隔，比一张卡放两个 text 更易扫读 */
	.reminderCard {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 24rpx 28rpx;
		border-radius: 16rpx;
		background-color: var(--c-card-soft);
		margin-bottom: 12rpx;
		border: 2rpx solid var(--c-border);
	}

	.reminderTime {
		min-width: 96rpx;
		font-size: 28rpx;
		font-weight: bold;
		color: var(--c-brand);
	}

	.reminderInfo {
		flex: 1;
		min-width: 0;
		margin-left: 24rpx;
		padding-left: 24rpx;
		border-left: 2rpx solid var(--c-border-strong);
	}

	/* 最近记录：类型徽标 + 标题 + 时间一行 */
	.recordRow {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 24rpx 28rpx;
		border-radius: 16rpx;
		background-color: var(--c-card);
		margin-bottom: 12rpx;
		border: 2rpx solid var(--c-border);
	}

	.recordDot {
		min-width: 88rpx;
		margin-right: 20rpx;
		padding: 5rpx 12rpx;
		border-radius: 8rpx;
		font-size: 22rpx;
		background-color: var(--c-mint);
		color: var(--c-brand);
		text-align: center;
	}
</style>
