<script setup lang="uts">
	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		// #ifdef APP
		// 恢复上次选的主题。不配 manifest 的 defaultAppTheme 时默认是 light，
		// 用户改过就按存的来；auto 表示跟随系统。
		const saved = uni.getStorageSync('app_theme')
		if (saved === 'light' || saved === 'dark' || saved === 'auto') {
			uni.setAppTheme({ theme: saved })
		}
		// #endif
		console.log('App Launch')
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* ============================================================
	   明路设计语言 —— 全 App 唯一一份，与设计稿
	   .hbuilderx/uni-agent/design/minglu-miniprogram-ui/assets/prototype.css 对齐。
	   改配色/圆角/字号只改这里，页面里不要再写字面量。
	   页面 style 只留「这个页面特有的布局」（宽度、边距、排列）。
	   ============================================================ */

	/* 图标字体。用字体而不是 SVG：App 不支持内联 svg 标签，<image src="*.svg"> 也没法用
	   css 换色——选中/未选中就得备两份文件。字体的 color 能跟着状态走，一个文件全搞定。
	   字形来自 utils/icons.ts，加图标见 scripts/build-iconfont.py。

	   两端加载方式不一样，必须条件编译：
	   - 微信小程序的 wxss @font-face 不加载包内本地字体文件（只认 https 网络地址和 base64），
	     表现是图标位置全空白、且不报错，只能内联。
	   - App 蒸汽模式反过来：吃 data URI 字体会崩（ConcurrentModificationException，
	     字体异步加载完成时改正在遍历的样式表，2026-10-26 实测），只能引包内文件。
	   base64 那串由 scripts/build-iconfont.py 重新生成，别手改。 */
	/* #ifdef MP */
	@font-face {
		font-family: MingluIcons;
		src: url('data:font/ttf;base64,');
	}
	/* #endif */
	/* #ifdef APP || H5 */
	@font-face {
		font-family: MingluIcons;
		src: url('/static/font/minglu-icons.ttf');
	}
	/* #endif */

	.ic {
		font-family: MingluIcons;
		font-size: 40rpx;
		line-height: 1;
	}

	/* ============================================================
	   主题变量。亮暗两套，靠 @media (prefers-color-scheme) 自动切换，系统夜间模式
	   变化时页面不重启即时刷新（真机实测）。加新颜色只改这里，页面里一律 var(--c-xxx)。
	   三个坑，改之前先看：
	   1. 变量必须定义在 page 选择器下——蒸汽模式不支持 :root
	   2. manifest.json 的 app.defaultAppTheme 必须是 auto，否则 appTheme 永远停在
	      light、暗色那套永远不匹配（实测过）
	   3. 变量值不能再是 var(--x)，也不要在 padding/margin 简写里用 var
	   两套配色都要过 WCAG AA，用 python contrast.py 验。
	   .hero* 和 .tabCenter* 不主题化：它们本身就叫深色，两端同一套字面量就够。
	   ============================================================ */
	@media (prefers-color-scheme: light) {
		page {
			--c-page: #FBFCF9;
			--c-card: #FFFFFF;
			--c-card-soft: #F4F7F4;
			--c-text: #1D3734;
			--c-text-2: #4A5C56;
			--c-muted: #788985;
			--c-faint: #9AA7A2;
			--c-brand: #24695B;
			--c-on-brand: #FFFFFF;
			--c-mint: #E6F2ED;
			--c-mint-text: #24695B;
			--c-danger: #C0392B;
			--c-danger-bg: #FBEAE7;
			--c-danger-text: #9A5A4E;
			--c-danger-border: rgba(192, 57, 43, .18);
			--c-warn: #A9701F;
			--c-warn-bg: #F7EFE2;
			--c-ok: #3D8975;
			--c-gray-bg: #EFF1EE;
			--c-ai-bubble: #F0F5F1;
			--c-border: rgba(36, 105, 91, .14);
			--c-border-weak: rgba(36, 105, 91, .08);
			--c-border-mid: rgba(36, 105, 91, .12);
			--c-border-strong: rgba(36, 105, 91, .18);
			--c-border-x: rgba(36, 105, 91, .35);
			--c-border-dash: rgba(36, 105, 91, .3);
			--c-shadow: rgba(29, 55, 52, .05);
			--c-shadow-strong: rgba(29, 55, 52, .14);
		}
	}

	@media (prefers-color-scheme: dark) {
		page {
			--c-page: #101614;
			--c-card: #1A2320;
			--c-card-soft: #202B27;
			--c-text: #E6EEE9;
			--c-text-2: #B7C6BF;
			--c-muted: #8E9E97;
			--c-faint: #879890;
			--c-brand: #6FC0A9;
			--c-on-brand: #0A1F1A;
			--c-mint: #1C3730;
			--c-mint-text: #8ADCC2;
			--c-danger: #F08B80;
			--c-danger-bg: #38201D;
			--c-danger-text: #F5A79E;
			--c-danger-border: rgba(240, 139, 128, .28);
			--c-warn: #DFA75C;
			--c-warn-bg: #33291A;
			--c-ok: #6DC3A9;
			--c-gray-bg: #232D28;
			--c-ai-bubble: #1E2B26;
			--c-border: rgba(127, 196, 176, .20);
			--c-border-weak: rgba(127, 196, 176, .12);
			--c-border-mid: rgba(127, 196, 176, .16);
			--c-border-strong: rgba(127, 196, 176, .26);
			--c-border-x: rgba(127, 196, 176, .45);
			--c-border-dash: rgba(127, 196, 176, .40);
			--c-shadow: rgba(0, 0, 0, .45);
			--c-shadow-strong: rgba(0, 0, 0, .55);
		}
	}

	/* 页面底色：暖白，不用纯白，长时间看不刺眼 */
	page {
		background-color: var(--c-page);
	}

	/* ---------------- 排版 ---------------- */
	/* 负字距：改版原型 h1 是 -.055em、greeting-name -.04em、hero h2 -.03em。
	   大字号不加负字距，中文标题会显得「散」。用 rpx 不用 em——蒸汽模式对 em 单位的
	   letter-spacing 没验证过，rpx 是确定的。42rpx 上 -.04em ≈ -1.7rpx，取 -2rpx。 */
	.h1 {
		font-size: 42rpx;
		font-weight: bold;
		color: var(--c-text);
		line-height: 1.35;
		letter-spacing: -2rpx;
	}

	.h2 {
		font-size: 32rpx;
		font-weight: bold;
		color: var(--c-text);
		line-height: 1.4;
	}

	.h3 {
		font-size: 30rpx;
		font-weight: bold;
		color: var(--c-text);
		line-height: 1.4;
	}

	.hint {
		font-size: 24rpx;
		color: var(--c-muted);
		line-height: 1.6;
	}

	.meta {
		font-size: 24rpx;
		color: var(--c-muted);
		line-height: 1.6;
	}

	.note {
		font-size: 22rpx;
		color: var(--c-faint);
		line-height: 1.6;
	}

	.loading {
		font-size: 26rpx;
		color: var(--c-faint);
	}

	.section {
		margin-top: 36rpx;
		margin-bottom: 16rpx;
		font-size: 28rpx;
		font-weight: bold;
		color: var(--c-text);
	}

	.error {
		margin-top: 24rpx;
		font-size: 26rpx;
		color: var(--c-danger);
		line-height: 1.6;
	}

	.warn {
		font-size: 24rpx;
		color: var(--c-danger);
		line-height: 1.6;
	}

	.warnText {
		font-size: 28rpx;
		font-weight: bold;
		color: var(--c-danger);
		line-height: 1.5;
	}

	.price {
		font-size: 32rpx;
		font-weight: bold;
		color: var(--c-danger);
	}

	.strong {
		color: var(--c-text);
		font-weight: 600;
	}

	/* ---------------- 卡片 ----------------
	   亮色主题 --c-page 是 #FBFCF9、--c-card 是 #FFFFFF，两者只差 4/255，而投影是
	   5% alpha——卡片等于浮在同样颜色的背景上，边界完全看不出来。改版原型里 .record /
	   .doctor-card / .metric / .menu-group / .quick **全都有 1px 边框**，我们之前漏了。
	   现在统一补上 var(--c-border)（亮 14% / 暗 20% 的品牌色透明通道），暗色主题下
	   这条边框也还在，不会出现「亮色有框暗色没框」。 */
	.card {
		padding: 28rpx;
		border-radius: 20rpx;
		background-color: var(--c-card);
		margin-bottom: 16rpx;
		border: 2rpx solid var(--c-border);
		box-shadow: 0 2rpx 6rpx var(--c-shadow), 0 8rpx 24rpx var(--c-shadow);
	}

	/* 同色系但无投影的变体，用于「页内嵌页」的次级信息块 */
	.cardSoft {
		padding: 24rpx;
		border-radius: 16rpx;
		background-color: var(--c-card-soft);
		margin-bottom: 16rpx;
		border: 2rpx solid var(--c-border);
	}

	.cardFlat {
		padding: 28rpx;
		border-radius: 20rpx;
		background-color: var(--c-card);
		margin-bottom: 16rpx;
		border: 2rpx solid var(--c-border);
	}

	.cardWarn {
		padding: 28rpx;
		border-radius: 20rpx;
		background-color: var(--c-danger-bg);
		margin-bottom: 16rpx;
	}

	/* 待确认状态：整卡换底色，不靠边框（蒸汽模式下动态 class 不重算，见 docs/agent/vapor-mode.md） */
	.cardPending {
		padding: 28rpx;
		border-radius: 20rpx;
		background-color: var(--c-danger-bg);
		margin-bottom: 16rpx;
	}

	.cardTitle {
		font-size: 30rpx;
		font-weight: bold;
		color: var(--c-text);
		line-height: 1.4;
	}

	.cardMeta {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: var(--c-muted);
		line-height: 1.5;
	}

	.formCard {
		margin-top: 16rpx;
	}

	/* 「当前使用中」这类小徽标，选中态靠 v-if 切 class，不靠动态 class */
	.using {
		margin-top: 12rpx;
		padding: 5rpx 16rpx;
		border-radius: 8rpx;
		font-size: 22rpx;
		background-color: var(--c-brand);
		color: var(--c-on-brand);
	}

	/* ---------------- 行 ---------------- */
	.row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.rowBetween {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.rowMe {
		justify-content: flex-end;
	}

	/* ---------------- 按钮 ----------------
	   注意：按钮里不要写 line-height。原生 button 自带垂直居中，
       叠一个等高的 line-height 会把文字压到偏下（实测多个按钮中招）。 */
	.btn {
		margin-top: 16rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
		background-color: var(--c-brand);
		color: var(--c-on-brand);
		border-radius: 16rpx;
		font-size: 30rpx;
		font-weight: 600;
	}

	.btn.ghost {
		background-color: var(--c-card);
		color: var(--c-brand);
		border: 2rpx solid var(--c-brand);
	}

	/* 登录页「获取验证码」：与输入框同行，宽度必须写死。
	   uvue 的 input 默认 width:100%，flex:1 的 basis 是 auto 会吃到这个 100%，
	   把同行按钮挤出容器后直接不渲染。 */
	.btn.small {
		margin-left: 20rpx;
		margin-top: 0;
		width: 230rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		font-size: 26rpx;
	}

	.mini {
		margin: 0 16rpx 0 0;
		padding: 13rpx 28rpx;
		font-size: 26rpx;
		background-color: var(--c-brand);
		color: var(--c-on-brand);
		border-radius: 12rpx;
	}

	.mini.ghost {
		background-color: var(--c-card);
		color: var(--c-brand);
		border: 2rpx solid var(--c-brand);
	}

	.textbtn {
		font-size: 26rpx;
		color: var(--c-brand);
		padding: 8rpx;
	}

	/* ---------------- 表单 ---------------- */
	.fieldLabel {
		font-size: 26rpx;
		color: var(--c-muted);
		margin-bottom: 10rpx;
	}

	.label {
		font-size: 26rpx;
		color: var(--c-muted);
		margin-bottom: 10rpx;
	}

	.input {
		height: 88rpx;
		border-radius: 16rpx;
		background-color: var(--c-card);
		padding-left: 24rpx;
		font-size: 30rpx;
		border: 2rpx solid var(--c-border);
	}

	.ta {
		width: 100%;
		border-radius: 16rpx;
		background-color: var(--c-card);
		padding: 24rpx;
		margin-bottom: 8rpx;
		font-size: 28rpx;
		line-height: 1.6;
		border: 2rpx solid var(--c-border);
	}

	.ta.small {
		min-height: 140rpx;
	}

	/* 出生日期选择器：picker 包一层 view，整块可点 */
	.dateBox {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 88rpx;
		padding: 0 24rpx;
		border-radius: 16rpx;
		background-color: var(--c-card);
		border: 2rpx solid var(--c-border);
	}

	.dateText {
		font-size: 30rpx;
		color: var(--c-text);
	}

	.datePh {
		font-size: 30rpx;
		color: var(--c-faint);
	}

	.dateAge {
		margin-left: auto;
		font-size: 26rpx;
		color: var(--c-brand);
		font-weight: 600;
	}

	.switchRow {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 24rpx;
	}

	.switchLabel {
		font-size: 26rpx;
		color: var(--c-text-2);
	}

	/* ---------------- 单选/多选项 ---------------- */
	.opt {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 26rpx;
		border-radius: 16rpx;
		background-color: var(--c-card);
		margin-bottom: 14rpx;
		border: 2rpx solid var(--c-border);
	}

	.optText {
		font-size: 28rpx;
		color: var(--c-text);
		line-height: 1.5;
	}

	.optCheck {
		margin-left: 20rpx;
		font-size: 32rpx;
		font-weight: bold;
		color: var(--c-brand);
	}

	/* 外观主题的按钮组：三个等宽按钮无缝拼成一个胶囊（改版原型 theme-options 的紧凑版）。
	   选中态用 v-if 换 .segOn（主色填充），**不写对号**——对号会多占一行把选中段撑高，
	   而填充色本身就是更强的选中信号。三段内容完全一样（一行文字 + 同一种 padding），
	   所以高度天然相等，不依赖 align-items 是否生效。
	   圆角只写在 .segBar 上，靠 overflow:hidden 把子元素方角裁掉：不用给首尾段单独写
	   radius，省掉 :last-child（蒸汽模式下没验证过）。 */
	.segBar {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		margin-bottom: 20rpx;
		border-radius: 999rpx;
		background-color: var(--c-card);
		border: 2rpx solid var(--c-border);
		overflow: hidden;
	}

	.segCell {
		flex: 1;
	}

	.seg {
		padding: 22rpx 0;
		align-items: center;
		justify-content: center;
	}

	.segOn {
		padding: 22rpx 0;
		align-items: center;
		justify-content: center;
		background-color: var(--c-brand);
	}

	.segText {
		font-size: 26rpx;
		color: var(--c-text-2);
	}

	.segOnText {
		font-size: 26rpx;
		font-weight: 600;
		color: var(--c-on-brand);
	}

	/* ---------------- 标签 / 胶囊 / 头像 ---------------- */
	.tag {
		padding: 5rpx 14rpx;
		border-radius: 8rpx;
		font-size: 22rpx;
		font-weight: 600;
	}

	.tagBrand {
		background-color: var(--c-mint);
		color: var(--c-brand);
	}

	.tagOk {
		background-color: var(--c-mint);
		color: var(--c-ok);
	}

	.tagWarn {
		background-color: var(--c-warn-bg);
		color: var(--c-warn);
	}

	.tagDanger {
		background-color: var(--c-danger-bg);
		color: var(--c-danger);
	}

	.tagMuted {
		background-color: var(--c-gray-bg);
		color: var(--c-muted);
	}

	.tagOutline {
		background-color: var(--c-card);
		color: var(--c-danger);
		border: 2rpx solid var(--c-danger);
	}

	.chip {
		padding: 14rpx 26rpx;
		border-radius: 999rpx;
		background-color: var(--c-card);
		font-size: 26rpx;
		color: var(--c-text-2);
		border: 2rpx solid var(--c-border);
	}

	/* 胶囊选中态不用动态 class（蒸汽模式不重算），改成 v-if 换一整个元素。
	   胶囊一律用 <button>：只包一个 <text> 的 view 收不到点击——text 带背景会渲染成
	   原生 TextView，点它不往父 view 冒泡。
	   高度用上下 padding 撑、不写 height：蒸汽模式下 button 一旦同时写 height 和
	   padding，原生垂直居中就失灵，文字会贴着胶囊上沿（实测 .chip 60rpx 偏高 13px，
	   去掉 height 只留 padding 后正常）。 */
	.chip {
		padding: 13rpx 26rpx;
		border-radius: 999rpx;
		background-color: var(--c-card);
		font-size: 26rpx;
		color: var(--c-text-2);
		border: 2rpx solid var(--c-border);
	}

	.chipOn {
		padding: 13rpx 26rpx;
		border-radius: 999rpx;
		background-color: var(--c-brand);
		font-size: 26rpx;
		color: var(--c-on-brand);
	}

	/* 胶囊横排时逐个的间距。不能用 `.chipRow > view`，蒸汽模式不支持子代选择器 */
	.chipItem {
		margin: 0 12rpx 12rpx 0;
	}

	.avatar {
		width: 72rpx;
		height: 72rpx;
		border-radius: 50%;
		background-color: var(--c-mint);
		color: var(--c-brand);
		font-size: 28rpx;
		font-weight: bold;
		/* 文字在圆里居中：text 不是 flex 容器，靠 text-align + 等高 line-height */
		align-items: center;
		justify-content: center;
		text-align: center;
		line-height: 72rpx;
	}

	/* 可点的头像。@tap 必须挂在带背景的这个 view 上：挂在 <text> 上实测点了没反应，
	   而「view 包一个带背景的 text」也收不到——text 带背景会渲染成原生 TextView，
	   不往父 view 冒泡（vapor-mode.md §9）。所以背景放 view 上，里面放不带背景的 text。 */
	.avatarBtn {
		width: 72rpx;
		height: 72rpx;
		border-radius: 50%;
		background-color: var(--c-mint);
		align-items: center;
		justify-content: center;
	}

	.avatarBtnText {
		color: var(--c-brand);
		font-size: 28rpx;
		font-weight: bold;
	}

