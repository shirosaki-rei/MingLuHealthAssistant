  background-color: #f2efe6;
}
.bubbleMe {
  background-color: #2f4f43;
}
.bubbleText {
  font-size: 28rpx;
  line-height: 1.6;
  color: #222222;
}
.aiTag {
  font-size: 20rpx;
  color: #8a8a8a;
  margin-top: 8rpx;
}
.controls {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}
.btn {
  flex: 1;
  margin-right: 12rpx;
  background-color: #2f4f43;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.ghost {
  background-color: #ffffff;
  color: #2f4f43;
}
.error {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #fbe9e7;
