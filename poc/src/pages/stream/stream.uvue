  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}
.rowAi {
  justify-content: flex-start;
}
.rowMe {
  justify-content: flex-end;
}
.bubble {
  max-width: 300px;
  border-radius: 16rpx;
  padding: 16rpx;
}
